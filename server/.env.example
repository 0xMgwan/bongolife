# Copy to server/.env
PORT=8787
# Required in production — long random string (openssl rand -hex 48)
JWT_SECRET=
# Usernames that can remove ads (comma separated)
ADMIN_USERNAMES=your_username
# Where the SQLite DB and uploaded ad images live
# DATA_DIR=/var/data/bongo-life

# ---- Real-money payments (wallet top-ups, billboard ads) via Wooble / PayGuard mobile money.
# Create an app in the Wooble merchant portal (Apps & API keys), add the Collection product,
# and paste its key + secret here. Leave empty to use demo mode in dev.
# sandbox = http://102.223.19.6:8010 (no real money, no callbacks); live = https://secure.payguard.tz
PAYGUARD_ENV=sandbox
PAYGUARD_COLLECTION_KEY=
PAYGUARD_COLLECTION_SECRET=
# Any long random string (openssl rand -hex 24). Set the product's callback URL in the portal to
#   https://<your-domain>/api/webhooks/payguard?token=<this value>
PAYGUARD_CALLBACK_TOKEN=
# # Railway Hobby has no fixed IP: send PayGuard calls through a static-IP proxy and whitelist that IP.
# PAYGUARD_PROXY_URL=http://user:pass@proxy-host:port
PAYGUARD_BASE_URL=  (override the base URL; normally not needed)
# Live calls are only accepted from whitelisted server IPs — email them to info@payguard.co.tz.
# In-game TSh credited per 1 real TZS
TOPUP_RATE=100
# Demo top-ups are on in dev and OFF in production unless you force them:
# ALLOW_DEMO_TOPUP=false

# ---- Password-reset emails (Forgot password) via Resend (resend.com — free tier).
# Without a key, reset codes are only printed to the server log.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
MAIL_FROM=Bongo Life <no-reply@yourdomain.com>
