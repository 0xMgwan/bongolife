# Copy to server/.env
PORT=8787
# Required in production — long random string (openssl rand -hex 48)
JWT_SECRET=
# Usernames that can remove ads (comma separated)
ADMIN_USERNAMES=your_username
# Where the SQLite DB and uploaded ad images live
# DATA_DIR=/var/data/bongo-life

# ---- Wallet top-ups via nTZS (mobile money). Leave empty to use demo mode in dev.
# Use an ntzs_test_ key first, then ntzs_live_. Money is collected into your nTZS
# platform wallet (treasury) — no treasury user id needed.
NTZS_API_KEY=
# Webhook signing secret from the nTZS dashboard. Set the webhook URL there to
#   https://<your-domain>/api/webhooks/ntzs
NTZS_WEBHOOK_SECRET=
# NTZS_BASE_URL=https://www.ntzs.co.tz
# In-game TSh credited per 1 real TZS
TOPUP_RATE=100
# Demo top-ups are on in dev and OFF in production unless you force them:
# ALLOW_DEMO_TOPUP=false

# ---- Password-reset emails (Forgot password) via Resend (resend.com — free tier).
# Without a key, reset codes are only printed to the server log.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
MAIL_FROM=Bongo Life <no-reply@yourdomain.com>
